{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HOTEL AI: Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "HOTEL AI: Git diff check",
      "type": "shell",
      "command": "git diff --check",
      "problemMatcher": []
    },
    {
      "label": "HOTEL AI: Legacy demo run",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["src/main.py"],
      "problemMatcher": []
    }
  ]
}
